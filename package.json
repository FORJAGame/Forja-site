{
  "name": "forja",
  "version": "0.1.0",
  "description": "Site da Forja, iniciativa de desenvolvimento de jogos do CESAR",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "vercel-build": "payload migrate && pnpm build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "node .next/standalone/server.js",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-deprecation vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait postgres storage && docker compose run --rm storage-buckets",
    "db:down": "docker compose down",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "tokens": "tsx scripts/generate-tokens.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "geist": "1.7.2",
    "graphql": "^16.8.1",
    "motion": "13.4.4",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^18.0.4",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "private": true
}
