DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/forja
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5432/forja_test
PAYLOAD_SECRET=troque-por-um-segredo-longo

# Imagens (S3). Local: SeaweedFS do docker-compose (`pnpm db:up`).
# Na nuvem: qualquer serviço compatível com S3, com um bucket por ambiente e uma chave restrita a ele (ver README › Variáveis de ambiente).
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=forja-media
S3_BUCKET_TEST=forja-media-test
S3_ACCESS_KEY_ID=forja
S3_SECRET_ACCESS_KEY=forja-dev-secret
